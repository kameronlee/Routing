EXPO_FORCE_WEBCONTAINER_ENV=1
EXPO_PUBLIC_ROUTING_API_URL=http://127.0.0.1:8010
# Optional: pin a timestamp for reproducible demos. When omitted, the backend
# uses the newest-dated UTCI raster if today's date is unavailable.
# EXPO_PUBLIC_ROUTING_DEPARTURE_TIME=2026-06-19T14:00:00

# Force Expo's websocket tunnel instead of the global @expo/ngrok package on Hopper.
# This avoids ngrok's fragile "undefined body" startup failure.
# EXPO_FORCE_WEBCONTAINER_ENV=0

# Expo starts the FastAPI routing backend from metro.config.js by default.
# EXPO_ROUTING_BACKEND_AUTOSTART=0
# ROUTING_BACKEND_PYTHON=/absolute/path/to/python
